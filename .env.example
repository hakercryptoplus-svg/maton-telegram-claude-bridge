# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Required: Your Telegram user ID (use @userinfobot to get it)
ALLOWED_TELEGRAM_USER_ID=123456789

# Optional: Override browser data directory (default: /data/browser)
# BROWSER_DATA_DIR=/data/browser

# Optional: Log level (debug | info | warn | error, default: info)
# LOG_LEVEL=info

# Optional: HTTP port (default: 10000)
# PORT=10000
